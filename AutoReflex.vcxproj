  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>

      <!-- Core optimization -->
      <Optimization>MaxSpeed</Optimization>                         <!-- /O2  -->
      <FavorSizeOrSpeed>Speed</FavorSizeOrSpeed>                    <!-- /Ot  -->
      <InlineFunctionExpansion>AnySuitable</InlineFunctionExpansion><!-- /Ob3 -->
      <IntrinsicFunctions>true</IntrinsicFunctions>                 <!-- /Oi  -->
      <OmitFramePointers>true</OmitFramePointers>                   <!-- /Oy  -->
      <FunctionLevelLinking>true</FunctionLevelLinking>             <!-- /Gy  -->
      <StringPooling>true</StringPooling>                           <!-- /GF  -->
      <FloatingPointModel>Fast</FloatingPointModel>                 <!-- /fp:fast -->

      <!-- Universal compatibility: stay on the x86-64 architectural baseline
           (SSE2 — required by x64 itself, present on every 64-bit Windows CPU
           ever shipped). Avoid /arch:AVX, /arch:AVX2, /arch:AVX512 — they pin
           the DLL to specific CPU generations and "illegal instruction" the
           moment a user with an older or trimmed-down chip loads it. -->
      <EnableEnhancedInstructionSet>StreamingSIMDExtensions2</EnableEnhancedInstructionSet>

      <!-- Whole-program / dead-code stripping. Pairs with /LTCG at link time. -->
      <WholeProgramOptimization>true</WholeProgramOptimization>     <!-- /GL  -->
      <RemoveUnreferencedCodeData>true</RemoveUnreferencedCodeData> <!-- /Zc:inline + COMDAT folding hints -->

      <!-- Stability-preserving guards we keep ON (perf cost is negligible
           and a DLL injected into a game should not throw safety to the
           wind): /GS (buffer security check), /EHsc (exceptions — EXPRTK
           uses them), RTTI (EXPRTK uses dynamic_cast). -->

      <SDLCheck>false</SDLCheck>
      <PreprocessorDefinitions>PLUGIN_EXPORTS;NDEBUG;_WINDOWS;_USRDLL;_CRT_SECURE_NO_WARNINGS;NOMINMAX;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <ConformanceMode>true</ConformanceMode>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <RuntimeLibrary>MultiThreadedDLL</RuntimeLibrary>
      <AdditionalIncludeDirectories>$(ProjectDir)sdk;$(ProjectDir)imgui;$(ProjectDir)imgui\misc\cpp;$(ProjectDir);$(ProjectDir)scripting;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>

      <!-- /bigobj: required for some EXPRTK TUs.
           /Zc:inline: drop unreferenced inline COMDATs.
           /Zc:throwingNew: assume operator new throws (lets the compiler
                            elide null checks after new).
           /cgthreads8: parallelize codegen across 8 threads. -->
      <AdditionalOptions>/bigobj /Zc:inline /Zc:throwingNew /cgthreads8 %(AdditionalOptions)</AdditionalOptions>
    </ClCompile>
    <Link>
      <AdditionalDependencies>%(AdditionalDependencies)</AdditionalDependencies>
      <SubSystem>Windows</SubSystem>

      <!-- Match /GL with /LTCG; fold identical COMDATs and drop unreferenced
           code/data in the final image. -->
      <LinkTimeCodeGeneration>UseLinkTimeCodeGeneration</LinkTimeCodeGeneration>
      <OptimizeReferences>true</OptimizeReferences>
      <EnableCOMDATFolding>true</EnableCOMDATFolding>

      <!-- Keep symbols for crash dumps. /DEBUG produces a PDB next to the
           DLL; runtime cost is zero. -->
      <GenerateDebugInformation>true</GenerateDebugInformation>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
